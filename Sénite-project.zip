
name: sens APK

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7

      - name: Build APK
        run: |
          unzip GameLite-project.zip -d src
          cd src/GameLite
          gradle assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: GameLite-apk
          path: src/GameLite/app/build/outputs/apk/debug/app-debug.apk
